# Optional local Docker Compose overrides. The stack also starts with the
# development-only defaults in docker-compose.yml.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
PGADMIN_PORT=5050

POSTGRES_DB=allinbloom
POSTGRES_USER=allinbloom
POSTGRES_PASSWORD=allinbloom_local_password_change_me
PGADMIN_DEFAULT_EMAIL=admin@allinbloom.us
PGADMIN_DEFAULT_PASSWORD=allinbloom-local-admin
ADMIN_EMAIL=allinbloom.us@gmail.com

# Leave blank to generate a fresh local secret at each backend start. Set a
# unique 32+ character value if you need local sessions to survive restarts.
AUTH_SECRET=
SEED_DATABASE=true
MIGRATION_LOCK_TIMEOUT_SECONDS=120
CRON_SYNC_LIMIT=200
CRON_INTERVAL_SECONDS=60
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_URL=https://in.logs.betterstack.com

# Optional integrations. Keep real production credentials out of this file.
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_TIDIO_PUBLIC_KEY=
